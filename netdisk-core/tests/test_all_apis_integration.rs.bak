#[cfg(test)]
mod tests {
    use actix_web::{test, web, App, middleware, dev::Service};
    use actix_http::Request;
    use netdisk_core::responses::prelude::*;
    use netdisk_core::netdisk_auth::basic_env::NetDiskEnv;
    use netdisk_core::netdisk_api::{
        auth_api, base_api, file_api, file_delete_api, file_list_api, 
        file_move_api, share_file_api, user_info_api, file_upload_api
    };
    use serde_json::json;

    /// 创建完整的测试应用，包含所有API路由
    async fn create_test_app() -> impl Service<Request, Response = actix_web::dev::ServiceResponse, Error = actix_web::Error> {
        test::init_service(
            App::new()
                .wrap(middleware::Logger::default())
                .app_data(web::Data::new(AccessToken {
                    access_token: "test_access_token".to_string(),
                    expired_at: chrono::Utc::now() + chrono::Duration::hours(1),
                }))
                .app_data(web::Data::new(NetDiskEnv::new().unwrap_or_default()))
                // 基础API
                .service(web::resource("/").route(web::get().to(base_api::hello)))
                .service(web::resource("/echo").route(web::post().to(base_api::echo)))
                // 认证API
                .service(web::resource("/access_token").route(web::post().to(auth_api::access_token)))
                .service(web::resource("/access_token_and_cache").route(web::post().to(auth_api::access_token_and_cache)))
                // 文件API
                .service(web::resource("/file/download").route(web::get().to(file_api::download)))
                .service(web::resource("/file/mkdir").route(web::post().to(file_api::mkdir)))
                .service(web::resource("/file/file_lists_query").route(web::get().to(file_api::file_lists_query)))
                .service(web::resource("/file/file_query").route(web::get().to(file_api::file_query)))
                .service(web::resource("/file/files_info").route(web::post().to(file_api::files_info)))
                // 文件删除API
                .service(web::resource("/file/trash").route(web::post().to(file_delete_api::trash)))
                .service(web::resource("/file/delete").route(web::post().to(file_delete_api::delete)))
                // 文件列表API
                .service(web::resource("/file/file_search").route(web::get().to(file_list_api::file_search)))
                // 文件移动API
                .service(web::resource("/file/move").route(web::post().to(file_move_api::move_file)))
                // 分享文件API
                .service(web::resource("/share/create").route(web::post().to(share_file_api::share_create)))
                .service(web::resource("/share/list").route(web::get().to(share_file_api::share_list)))
                .service(web::resource("/share/list/info").route(web::put().to(share_file_api::share_list_info)))
                .service(web::resource("/share/content-payment/creat").route(web::put().to(share_file_api::pay_link)))
                .service(web::resource("/share/list/payment/info").route(web::put().to(share_file_api::change_share_list_info)))
                .service(web::resource("/share/payment/list").route(web::get().to(share_file_api::payment_list)))
                // 用户信息API
                .service(web::resource("/user_info").route(web::get().to(user_info_api::user_info)))
                // 文件上传API
                .service(web::resource("/file/upload").route(web::post().to(file_upload_api::file_upload)))
        ).await
    }

    // ==================== 基础API测试 ====================

    #[actix_web::test]
    async fn test_base_hello() {
        println!("=== 基础API - Hello接口测试 ===");
        let app = create_test_app().await;
        
        let req = test::TestRequest::get()
            .uri("/")
            .to_request();

        let resp = test::call_service(&app, req).await;
        println!("响应状态: {}", resp.status());
        
        let body = test::read_body(resp).await;
        let body_str = String::from_utf8(body.to_vec()).unwrap();
        println!("响应体: {}", body_str);
        
        assert!(body_str.contains("Hello 123Pan!"));
    }

    #[actix_web::test]
    async fn test_base_echo() {
        println!("=== 基础API - Echo接口测试 ===");
        let app = create_test_app().await;
        
        let test_data = "测试回显数据";
        let req = test::TestRequest::post()
            .uri("/echo")
            .set_payload(test_data)
            .to_request();

        let resp = test::call_service(&app, req).await;
        println!("响应状态: {}", resp.status());
        
        let body = test::read_body(resp).await;
        let body_str = String::from_utf8(body.to_vec()).unwrap();
        println!("响应体: {}", body_str);
        
        assert_eq!(body_str, test_data);
    }

    // ==================== 文件API测试 ====================

    #[actix_web::test]
    async fn test_file_query_http() {
        println!("=== 文件API - 文件查询接口测试 ===");
        let app = create_test_app().await;
        
        let req = test::TestRequest::get()
            .uri("/file/file_query?fileID=12345")
            .to_request();

        let resp = test::call_service(&app, req).await;
        println!("响应状态: {}", resp.status());
        
        let body = test::read_body(resp).await;
        let body_str = String::from_utf8(body.to_vec()).unwrap();
        println!("响应体: {}", body_str);
        
        // 验证响应是有效的JSON
        if let Ok(json_resp) = serde_json::from_str::<serde_json::Value>(&body_str) {
            assert!(json_resp.get("code").is_some());
            assert!(json_resp.get("message").is_some());
        }
    }

