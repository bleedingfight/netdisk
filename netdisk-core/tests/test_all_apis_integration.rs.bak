    // ==================== 路由配置测试 ====================

    #[actix_web::test]
    async fn test_all_routes_config() {
        println!("=== 所有路由配置测试 ===");
        let app = create_test_app().await;
        
        // 测试各种路由
        let routes = vec![
            ("/", "GET", "基础Hello路由"),
            ("/echo", "POST", "基础Echo路由"),
            ("/file/file_query?fileID=123", "GET", "文件查询路由"),
            ("/file/download?fileID=123", "GET", "文件下载路由"),
            ("/user_info", "GET", "用户信息路由"),
            ("/share/list?limit=10", "GET", "分享列表路由"),
        ];

        for (path, method, description) in routes {
            println!("测试 {}: {}", description, path);
            
            let req = match method {
                "GET" => test::TestRequest::get().uri(path).to_request(),
                "POST" => test::TestRequest::post().uri(path).to_request(),
                "PUT" => test::TestRequest::put().uri(path).to_request(),
                _ => continue,
            };

            let resp = test::call_service(&app, req).await;
            println!("  状态: {}", resp.status());
            
            // 验证有响应（不管是成功还是错误）
            assert!(resp.status().as_u16() > 0);
        }
    }
}